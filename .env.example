# ════════════════════════════════════════════════════════════════════════════
# PG CRM — Environment Variables Template (PG-CORE)
# Copy this file to .env and fill in real values before running docker compose.
# ════════════════════════════════════════════════════════════════════════════

# 🗄️ Database ───────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=pgcrm123          # PostgreSQL password

# 🔐 Security ────────────────────────────────────────────────────────────────
JWT_SECRET=ChangeThisToASecureRandomStringOfAtLeast256BitsForHS256Algorithm

# 📧 Gmail / Email ───────────────────────────────────────────────────────────
MAIL_ENABLED=false            # Set to true to enable email notifications
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password   # Generate from Google Account → App Passwords

# 💳 Razorpay (Payment Gateway) ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 📱 WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# 🌐 CORS & Frontend URL ─────────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173

# 🏠 Branding ────────────────────────────────────────────────────────────────
PG_NAME=PG CRM
PG_PRIMARY_COLOR=#2563eb

# ⚙️ Active Profile ──────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
